{
  "name": "doka-site",
  "type": "module",
  "version": "1.0.0",
  "description": "ДОКА — Интеллектуальная система автоматизации ВЭД-логистики",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321 --allowed-hosts crazedns.ru,demo.docka.crazedns.ru,localhost",
    "check": "astro check",
    "detect": "npx --yes impeccable detect src/",
    "detect:html": "npx --yes impeccable detect dist/index.html",
    "qa": "npm run build && npm run detect"
  },
  "dependencies": {
    "astro": "^5.12.0"
  }
}
