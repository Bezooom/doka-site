---
import LeadFormIsland from "./islands/LeadForm";
import { COMPANY, LEAD_FORM } from "../consts";
---

<LeadFormIsland
  client:idle
  submitUrl={LEAD_FORM.endpoint}
  mailtoHref={LEAD_FORM.mailto}
  telegramHref={LEAD_FORM.telegram}
  inbox={COMPANY.email}
  maxFiles={LEAD_FORM.maxFiles}
  maxFileMb={LEAD_FORM.maxFileMb}
  phone={COMPANY.phone}
  phoneHref={COMPANY.phoneHref}
/>

<style is:global>
  .lead-card { padding: 28px; }
  .lead-intro { margin-bottom: 20px; }
  .lead-intro-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .lead-nda {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-doka-accent);
    font-weight: 600;
  }
  .lead-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-doka-primary);
    margin: 0 0 6px;
  }
  .lead-desc {
    font-size: 0.875rem;
    color: var(--color-doka-text-muted);
    line-height: 1.5;
    margin: 0;
  }
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lead-form[hidden],
  .lead-success[hidden] {
    display: none !important;
  }
  .lead-honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-contacts-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .lead-drop {
    border: 2px dashed var(--color-doka-border-dark);
    border-radius: var(--radius-doka);
    padding: 20px;
    text-align: center;
    background: var(--color-doka-surface-muted);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .lead-drop.is-drag {
    border-color: #C05621;
    background: rgba(192, 86, 33, 0.06);
  }
  .lead-drop-icon {
    margin-bottom: 6px;
    color: var(--color-doka-primary);
    display: flex;
    justify-content: center;
  }
  .lead-drop-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-doka-primary);
  }
  .lead-drop-hint {
    font-size: 0.75rem;
    color: var(--color-doka-text-dim);
    margin-top: 4px;
    line-height: 1.4;
  }
  .lead-files {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-doka-accent);
    line-height: 1.45;
  }
  .lead-files.is-error { color: var(--color-doka-danger); }
  .lead-submit { width: 100%; padding: 14px; font-size: 0.9375rem; }
  .lead-submit:disabled { opacity: 0.65; cursor: wait; }
  .lead-status {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: center;
    min-height: 1.2em;
  }
  .lead-status.is-error { color: var(--color-doka-danger); }
  .lead-legal {
    font-size: 0.75rem;
    color: var(--color-doka-text-dim);
    text-align: center;
    line-height: 1.4;
    margin: 0;
  }
  .lead-legal a { color: var(--color-doka-accent); }
  .lead-success { padding: 8px 0 4px; }
  .lead-success-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-doka-primary);
    margin: 0 0 8px;
  }
  .lead-success-body {
    font-size: 0.9375rem;
    color: var(--color-doka-text-muted);
    line-height: 1.5;
    margin: 0;
  }
  .lead-direct {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-doka-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .lead-direct > span {
    font-size: 0.8125rem;
    color: var(--color-doka-text-muted);
  }
  .lead-direct-btn { padding: 6px 12px; font-size: 0.8125rem; }
  @media (max-width: 600px) {
    .form-contacts-row { grid-template-columns: 1fr; }
  }
</style>
