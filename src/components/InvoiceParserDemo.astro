---
import InvoiceParserDemoIsland from "./islands/InvoiceParserDemo";
---

<InvoiceParserDemoIsland client:visible />

<style is:global>
  .ipd {
    background: var(--color-doka-surface);
    border: 1px solid var(--color-doka-border-dark);
    border-radius: var(--radius-doka-lg);
    box-shadow: var(--shadow-doka-md);
    overflow: hidden;
  }
  .ipd-bar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px 10px;
    background: var(--color-doka-surface);
    border-bottom: 1px solid var(--color-doka-border);
  }
  .ipd-docs,
  .ipd-views {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ipd-doc,
  .ipd-view {
    appearance: none;
    cursor: pointer;
    font-family: var(--font-sans);
    border-radius: 6px;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .ipd-doc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 7px 10px;
    background: var(--color-doka-surface-muted);
    border: 1px solid var(--color-doka-border);
    color: var(--color-doka-text-muted);
    text-align: left;
    min-width: 0;
  }
  .ipd-doc-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-doka-primary);
  }
  .ipd-doc-meta {
    font-size: 11px;
    color: var(--color-doka-text-dim);
  }
  .ipd-doc:hover { border-color: var(--color-doka-border-dark); }
  .ipd-doc.is-on {
    background: var(--color-doka-primary);
    border-color: var(--color-doka-primary);
  }
  .ipd-doc.is-on .ipd-doc-name,
  .ipd-doc.is-on .ipd-doc-meta { color: #fff; }
  .ipd-view {
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-doka-text-dim);
  }
  .ipd-view:hover { color: var(--color-doka-text-main); }
  .ipd-view.is-on {
    color: var(--color-doka-accent);
    border-color: #FBD38D;
    background: #FFFBEB;
  }
  .ipd-stage { margin: 0; background: var(--color-doka-surface-muted); }
  .ipd-stage img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: top;
  }
  .ipd-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
    padding: 12px 14px;
    background: var(--color-doka-surface);
    border-top: 1px solid var(--color-doka-border);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-doka-text-muted);
  }
  .ipd-risk {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ipd-risk-ok { background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; }
  .ipd-risk-warn { background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; }
  .ipd-risk-bad { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; }
  .ipd-case {
    margin-left: auto;
    color: var(--color-doka-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .ipd-case:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .ipd-doc { flex: 1 1 calc(50% - 6px); }
    .ipd-case { margin-left: 0; }
  }
</style>
