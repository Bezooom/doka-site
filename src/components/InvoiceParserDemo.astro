---
// Интерактив: реальные кадры контура, одни и те же 4 вымышленных инвойса.
const DOCS = [
  {
    id: "helionix",
    short: "Helionix",
    label: "ИТ · 2 позиции",
    risk: "Средний",
    riskTone: "warn",
    caseHref: "/cases/tnved-obosnovanie/",
    caseLabel: "Кейс: обоснование кодов",
    views: [
      {
        id: "switch",
        label: "Коммутатор",
        src: "/screens/doka-helionix-switch.jpg",
        alt: "ДОКА: инвойс Helionix, позиция коммутатора NX-S48, код 8517620002",
        caption: "Коммутатор NX-S48 → 8517620002. Отказ от 8537 и соседнего 8536.",
      },
      {
        id: "server",
        label: "Сервер",
        src: "/screens/doka-helionix-server.jpg",
        alt: "ДОКА: сервер Helionix RX-2208, код 8471500000",
        caption: "Сервер RX-2208 → 8471500000, не микросхемы 8542 и не мониторы 84716.",
      },
      {
        id: "analytics",
        label: "Консилиум",
        src: "/screens/doka-helionix-analytics.jpg",
        alt: "ДОКА: консилиум по Helionix, риск средний",
        caption: "Риск средний: в карточке нет контракта и Incoterms, хотя они есть на PDF.",
      },
    ],
  },
  {
    id: "aurelia",
    short: "Aurelia",
    label: "Корм / химия · 2 позиции",
    risk: "Низкий",
    riskTone: "ok",
    caseHref: "/cases/doka/",
    caseLabel: "Кейс: разбор инвойса",
    views: [
      {
        id: "item",
        label: "Графа 31",
        src: "/screens/doka-aurelia-item.jpg",
        alt: "ДОКА: холинхлорид Aurelia, Графа 31 и код 2309909601",
        caption: "Холинхлорид 75% на носителе → 2309909601. Бетаин → 2923900000.",
      },
      {
        id: "council",
        label: "Консилиум",
        src: "/screens/doka-aurelia-council.jpg",
        alt: "ДОКА: консилиум Aurelia, риск низкий, статус Одобрено",
        caption: "Юрист и координатор: глава совпадает с описанием, документ одобрен. Попросить весовые документы.",
      },
    ],
  },
  {
    id: "nordvolt",
    short: "Nordvolt",
    label: "Электро · 4 позиции",
    risk: "Низкий",
    riskTone: "ok",
    caseHref: "/cases/alta-xml/",
    caseLabel: "Кейс: XML в Альта",
    views: [
      {
        id: "list",
        label: "4 позиции",
        src: "/screens/doka-nordvolt-list.jpg",
        alt: "ДОКА: четыре позиции Nordvolt с кодами ТН ВЭД",
        caption: "Сервопривод, БП, автомат, трансформатор тока — 4/4 кода, риск низкий.",
      },
      {
        id: "item",
        label: "Карточка",
        src: "/screens/doka-nordvolt-item.jpg",
        alt: "ДОКА: карточка позиции Nordvolt с Графой 31",
        caption: "Готовая спецификация: можно сверять и выгружать XML-проект в Альта-ГТД.",
      },
      {
        id: "analytics",
        label: "Консилиум",
        src: "/screens/doka-nordvolt-analytics.jpg",
        alt: "ДОКА: консилиум Nordvolt, риск низкий",
        caption: "Консилиум подтверждает коды. Документ готов к проверке декларантом.",
      },
    ],
  },
  {
    id: "velaero",
    short: "Velaero",
    label: "Прекурсоры · 3 позиции",
    risk: "Высокий",
    riskTone: "bad",
    caseHref: "/cases/precursors-avia/",
    caseLabel: "Кейс: ПП-681",
    views: [
      {
        id: "items",
        label: "Позиции",
        src: "/screens/doka-velaero-items.jpg",
        alt: "ДОКА: три позиции прекурсоров Velaero, фильтр ПП-681",
        caption: "МЭК 2914120000, толуол 2902300000, ацетон 2914110000. Бейдж «Прекурсоры 3».",
      },
      {
        id: "council",
        label: "Консилиум",
        src: "/screens/doka-velaero-council.jpg",
        alt: "ДОКА: консилиум Velaero, высокий риск, особый порядок ПП-681",
        caption: "Не «обычный растворитель»: лицензия, журнал учёта, статус не «Одобрено».",
      },
    ],
  },
];

const first = DOCS[0];
const firstView = first.views[0];
---

<div class="ipd" id="invoice-parser-demo" data-docs={JSON.stringify(DOCS)}>
  <div class="ipd-bar">
    <div class="ipd-docs" role="tablist" aria-label="Демо-инвойс">
      {DOCS.map((doc, i) => (
        <button
          type="button"
          class:list={["ipd-doc", { "is-on": i === 0 }]}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          data-doc={doc.id}
        >
          <span class="ipd-doc-name">{doc.short}</span>
          <span class="ipd-doc-meta">{doc.label}</span>
        </button>
      ))}
    </div>
    <div class="ipd-views" role="tablist" aria-label="Вкладка разбора">
      {first.views.map((view, i) => (
        <button
          type="button"
          class:list={["ipd-view", { "is-on": i === 0 }]}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          data-view={view.id}
        >
          {view.label}
        </button>
      ))}
    </div>
  </div>

  <figure class="ipd-stage">
    <img
      id="ipd-shot"
      src={firstView.src}
      alt={firstView.alt}
      width="1680"
      height="980"
      decoding="async"
      fetchpriority="high"
    />
    <figcaption class="ipd-cap">
      <span class:list={["ipd-risk", `ipd-risk-${first.riskTone}`]} id="ipd-risk">
        Риск: {first.risk}
      </span>
      <span id="ipd-caption">{firstView.caption}</span>
      <a id="ipd-case" href={first.caseHref}>{first.caseLabel} →</a>
    </figcaption>
  </figure>
</div>

<style>
  .ipd {
    background: var(--color-doka-surface);
    border: 1px solid var(--color-doka-border-dark);
    border-radius: var(--radius-doka-lg);
    box-shadow: var(--shadow-doka-md);
    overflow: hidden;
  }
  .ipd-bar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px 10px;
    background: var(--color-doka-surface);
    border-bottom: 1px solid var(--color-doka-border);
  }
  .ipd-docs,
  .ipd-views {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ipd-doc,
  .ipd-view {
    appearance: none;
    cursor: pointer;
    font-family: var(--font-sans);
    border-radius: 6px;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .ipd-doc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 7px 10px;
    background: var(--color-doka-surface-muted);
    border: 1px solid var(--color-doka-border);
    color: var(--color-doka-text-muted);
    text-align: left;
    min-width: 0;
  }
  .ipd-doc-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-doka-primary);
  }
  .ipd-doc-meta {
    font-size: 11px;
    color: var(--color-doka-text-dim);
  }
  .ipd-doc:hover { border-color: var(--color-doka-border-dark); }
  .ipd-doc.is-on {
    background: var(--color-doka-primary);
    border-color: var(--color-doka-primary);
  }
  .ipd-doc.is-on .ipd-doc-name,
  .ipd-doc.is-on .ipd-doc-meta { color: #fff; }
  .ipd-view {
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-doka-text-dim);
  }
  .ipd-view:hover { color: var(--color-doka-text-main); }
  .ipd-view.is-on {
    color: var(--color-doka-accent);
    border-color: #FBD38D;
    background: #FFFBEB;
  }
  .ipd-stage { margin: 0; background: var(--color-doka-surface-muted); }
  .ipd-stage img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: top;
  }
  .ipd-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
    padding: 12px 14px;
    background: var(--color-doka-surface);
    border-top: 1px solid var(--color-doka-border);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-doka-text-muted);
  }
  .ipd-risk {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ipd-risk-ok { background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; }
  .ipd-risk-warn { background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; }
  .ipd-risk-bad { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; }
  #ipd-case {
    margin-left: auto;
    color: var(--color-doka-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  #ipd-case:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .ipd-doc { flex: 1 1 calc(50% - 6px); }
    #ipd-case { margin-left: 0; }
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById("invoice-parser-demo");
    if (!root) return;
    const docs = JSON.parse(root.getAttribute("data-docs") || "[]");
    if (!docs.length) return;

    const shot = document.getElementById("ipd-shot");
    const cap = document.getElementById("ipd-caption");
    const riskEl = document.getElementById("ipd-risk");
    const caseEl = document.getElementById("ipd-case");
    const viewsBox = root.querySelector(".ipd-views");
    let docId = docs[0].id;
    let viewId = docs[0].views[0].id;

    function findDoc(id) {
      return docs.find((d) => d.id === id) || docs[0];
    }
    function findView(doc, id) {
      return doc.views.find((v) => v.id === id) || doc.views[0];
    }

    docs.forEach((d) => {
      d.views.forEach((v) => {
        const img = new Image();
        img.src = v.src;
      });
    });

    function paintViews(doc) {
      viewsBox.innerHTML = "";
      doc.views.forEach((v) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "ipd-view" + (v.id === viewId ? " is-on" : "");
        b.setAttribute("role", "tab");
        b.setAttribute("aria-selected", v.id === viewId ? "true" : "false");
        b.dataset.view = v.id;
        b.textContent = v.label;
        viewsBox.appendChild(b);
      });
    }

    function apply() {
      const doc = findDoc(docId);
      const view = findView(doc, viewId);
      viewId = view.id;
      shot.src = view.src;
      shot.alt = view.alt;
      cap.textContent = view.caption;
      riskEl.textContent = "Риск: " + doc.risk;
      riskEl.className = "ipd-risk ipd-risk-" + doc.riskTone;
      caseEl.href = doc.caseHref;
      caseEl.textContent = doc.caseLabel + " →";
      root.querySelectorAll(".ipd-doc").forEach((b) => {
        const on = b.dataset.doc === docId;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      paintViews(doc);
    }

    root.addEventListener("click", (e) => {
      const docBtn = e.target.closest(".ipd-doc");
      const viewBtn = e.target.closest(".ipd-view");
      if (docBtn) {
        docId = docBtn.dataset.doc;
        viewId = findDoc(docId).views[0].id;
        apply();
      } else if (viewBtn) {
        viewId = viewBtn.dataset.view;
        apply();
      }
    });
  })();
</script>
