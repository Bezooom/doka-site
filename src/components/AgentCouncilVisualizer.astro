---
import AgentCouncilVisualizerIsland from "./islands/AgentCouncilVisualizer";
---

<AgentCouncilVisualizerIsland client:visible />

<style is:global>
  .council-doc-btn {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    color: #475569;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .council-doc-btn:hover {
    border-color: #DD6B20;
    color: #0F172A;
  }
  .council-doc-btn.active {
    background: #122A42;
    border-color: #122A42;
    color: #FFFFFF;
    font-weight: 600;
  }

  .pipeline-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 12px 14px;
  }

  .scan-laser-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ED8936, transparent);
    box-shadow: 0 0 8px #ED8936;
    animation: laserScan 2.5s ease-in-out infinite alternate;
  }

  @keyframes laserScan {
    0% { top: 0%; }
    100% { top: 92%; }
  }

  @media (max-width: 640px) {
    .mac-body-grid { grid-template-columns: 1fr !important; }
    .mini-doc-preview { display: none; }
  }
  @media (max-width: 480px) {
    #doc-selector-buttons { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .council-doc-btn span { display: none; }
    .council-doc-btn { padding: 6px 10px; }
  }
</style>
