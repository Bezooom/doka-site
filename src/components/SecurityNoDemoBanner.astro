---
// SecurityNoDemoBanner — Блок объяснения отсутствия публичного веб-демо из-за 152-ФЗ и безопасности
import { COMPANY } from "../consts";
---

<div class="security-nodemo-banner" style="background: linear-gradient(135deg, #1A365D 0%, #0F172A 100%); border: 1px solid rgba(221, 107, 32, 0.3); border-radius: var(--radius-doka-lg); padding: 28px; color: #FFFFFF; box-shadow: var(--shadow-doka-lg); margin-top: 40px; margin-bottom: 40px;">
  <div style="display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap;">
    <div style="background: rgba(221, 107, 32, 0.15); border: 1px solid #DD6B20; padding: 12px; border-radius: 12px; color: #ED8936; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>

    <div style="flex: 1; min-width: 0;">
      <div style="display: flex; items-center; gap: 10px; margin-bottom: 8px; flex-wrap: wrap;">
        <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #ED8936; font-weight: 700; text-transform: uppercase; tracking-spacing: 0.05em;">
          Безопасность & Суверенный контур (152-ФЗ / 289-ФЗ)
        </span>
        <span class="doka-badge doka-badge-navy" style="font-size: 11px; background: rgba(255,255,255,0.1); color: #94A3B8; border-color: rgba(255,255,255,0.2);">
          No-Cloud Policy
        </span>
      </div>

      <h2 style="font-size: clamp(1.25rem, 2.5vw, 1.6rem); color: #FFFFFF; font-weight: 700; margin-bottom: 14px; line-height: 1.3;">
        Почему у ДОКА нет «публичного демо в интернете»?
      </h2>

      <p style="font-size: 0.9375rem; color: #94A3B8; line-height: 1.65; margin-bottom: 16px;">
        Любой коммерческий инвойс или спецификация ВЭД — это чувствительная коммерческая тайна: закупочные цены поставщиков, наименования зарубежных фабрик, артикулы и условия Incoterms. <strong>Загружать такие файлы в открытые веб-сервисы или облачные нейросети (ChatGPT, Claude) — прямой риск утечки коммерческих данных и нарушение 152-ФЗ и 289-ФЗ.</strong>
      </p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;" class="security-reasons-grid">
        <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); padding: 14px; border-radius: 8px;">
          <div style="font-weight: 700; color: #FBD38D; font-size: 0.875rem; margin-bottom: 4px;">
            🔒 On-Premises
          </div>
          <div style="font-size: 0.8125rem; color: #CBD5E1; line-height: 1.5;">
            ДОКА разворачивается непосредственно на серверах вашей компании в защищённой локальной сети (LAN). Никакого взаимодействия со сторонними серверами.
          </div>
        </div>

        <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); padding: 14px; border-radius: 8px;">
          <div style="font-weight: 700; color: #FBD38D; font-size: 0.875rem; margin-bottom: 4px;">
            📋 Проверка по NDA
          </div>
          <div style="font-size: 0.8125rem; color: #CBD5E1; line-height: 1.5;">
            Оценка точности подбора кодов ТН ВЭД проходит на 5 обезличенных инвойсах в изолированном контуре {COMPANY.name} с подписание договора конфиденциальности.
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <a href="/razbor/" class="doka-btn doka-btn-orange" style="font-size: 0.875rem; padding: 10px 18px;">
          Заказать тестовый разбор по NDA →
        </a>
        <a href="/about/" style="font-size: 0.8125rem; color: #94A3B8; text-decoration: underline;">
          Правовая база и Свидетельство Роспатента №2026681995
        </a>
      </div>
    </div>
  </div>
</div>

<style is:raw>
  @media (max-width: 700px) {
    .security-reasons-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 480px) {
    .security-nodemo-banner { padding: 20px 16px !important; }
  }
</style>
