---
import RoiCalculatorIsland from "./islands/RoiCalculator";
---

<RoiCalculatorIsland client:visible />

<style is:global>
  .roi-calc-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 28px;
  }
  @media (max-width: 800px) {
    .roi-calc-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .roi-calc-grid { gap: 16px; }
  }
</style>
