---
// CaseVisualCard — карточка кейса с визуалом
interface Props {
  title: string;
  description: string;
  href: string;
  tag?: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
}

const { title, description, href, tag, tags, image, imageAlt } = Astro.props;
---

<article class="case-card" itemscope itemtype="https://schema.org/Article">
  <a href={href} class="case-card__link" aria-label={title}>
    {image && (
      <div class="case-card__image">
        <img
          src={image}
          alt={imageAlt ?? title}
          width="400"
          height="220"
          loading="lazy"
          itemprop="image"
        />
      </div>
    )}
    <div class="case-card__body">
      <div class="case-card__meta">
        {tag && <span class="badge">{tag}</span>}
        {tags?.map((t) => <span class="badge" key={t}>{t}</span>)}
      </div>
      <h3 class="case-card__title" itemprop="headline">{title}</h3>
      <p class="case-card__desc" itemprop="description">{description}</p>
    </div>
  </a>
</article>

<style is:raw>
.case-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: box-shadow 0.2s, transform 0.2s;
}
.case-card:hover {
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  transform: translateY(-2px);
}
.case-card__link {
  display: block;
  text-decoration: none;
  color: inherit;
}
.case-card__link:hover { text-decoration: none; color: inherit; }
.case-card__image {
  background: var(--bg-alt);
  padding: 16px;
  border-bottom: 1px solid var(--border);
}
.case-card__image img {
  width: 100%;
  height: auto;
  border-radius: 8px;
}
.case-card__body {
  padding: 20px;
}
.case-card__meta {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.case-card__title {
  font-size: 18px;
  margin: 0 0 8px;
  line-height: 1.3;
}
.case-card__desc {
  color: var(--muted);
  font-size: 14px;
  margin: 0;
  line-height: 1.6;
}
</style>
