---
// Подробный кейс системы ДОКА с реальными скриншотами интерфейса
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedReading from "../../components/RelatedReading.astro";
import { AUTHOR, CO_AUTHOR, CERT_ID, SITE_CANONICAL_BASE, RELATED_BY_PAGE } from "../../consts";
import LeadForm from "../../components/LeadForm.astro";
---

<BaseLayout
  title="Кейс: Внедрение ИИ-системы ДОКА для декларирования сложной номенклатуры"
  description="Подробный кейс автоматизации разбора 32-страничных инвойсов, классификации кодов ТН ВЭД и выгрузки XML-проектов в Альта-ГТД."
  canonical={`${SITE_CANONICAL_BASE}/cases/doka/`}
>
  <section class="section" style="padding-top: 48px;">
    <div class="container" style="max-width: 900px;">
      <div style="margin-bottom: 32px;">
        <span class="doka-badge doka-badge-orange" style="margin-bottom: 12px;">Практический кейс</span>
        <h1 style="font-size: clamp(2rem, 3.8vw, 2.8rem); line-height: 1.2; color: var(--color-doka-primary); margin-bottom: 16px;">
          Автоматизация разбора инвойсов и подбора кодов ТН ВЭД для дистрибьютора промышленного оборудования
        </h1>
        <div style="font-size: 1.0625rem; color: var(--color-doka-text-muted); line-height: 1.6;">
          Как команда ИИ-экспертов ДОКА сократила время подготовки таможенной декларации с 4 часов до 3 минут на один инвойс.
        </div>
      </div>

      <!-- Case Key Stats Banner -->
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; background: var(--color-doka-primary); color: #FFFFFF; padding: 24px; border-radius: var(--radius-doka-lg); margin-bottom: 40px;" class="case-kpi-grid">
        <div>
          <div style="font-family: var(--font-mono); font-size: 1.6rem; font-weight: 700; color: #ED8936;">4 часа → 3 мин</div>
          <div style="font-size: 0.75rem; color: #CBD5E1;">Время обработки</div>
        </div>
        <div>
          <div style="font-family: var(--font-mono); font-size: 1.6rem; font-weight: 700; color: #34D399;">Графа 31</div>
          <div style="font-size: 0.75rem; color: #CBD5E1;">+ обоснование кода</div>
        </div>
        <div>
          <div style="font-family: var(--font-mono); font-size: 1.6rem; font-weight: 700; color: #A78BFA;">XML OK</div>
          <div style="font-size: 0.75rem; color: #CBD5E1;">схема Альта-ГТД</div>
        </div>
        <div>
          <div style="font-family: var(--font-mono); font-size: 1.4rem; font-weight: 700; color: #FBBF24;">Ваш сервер</div>
          <div style="font-size: 0.75rem; color: #CBD5E1;">Безопасный контур</div>
        </div>
      </div>

      <figure style="margin: 0 0 32px; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #0F172A;">
        <video
          controls
          playsinline
          preload="metadata"
          poster="/video/doka-demo-poster.jpg"
          style="width: 100%; height: auto; display: block;"
        >
          <source src="/video/doka-demo.mp4" type="video/mp4" />
        </video>
        <figcaption style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
          Скринкаст прогона четырёх вымышленных инвойсов: Helionix, Aurelia Chemie, Nordvolt и Velaero (прекурсоры ПП-681). Контрагенты, ИНН и IBAN выдуманы.
        </figcaption>
      </figure>

      <div style="font-size: 1rem; color: var(--color-doka-text-muted); line-height: 1.8; margin-bottom: 40px;">
        <h2 style="font-size: 1.5rem; color: var(--color-doka-primary); margin: 32px 0 16px;">1. Четыре разных оригинала, один контур</h2>
        <p>
          Для съёмки мы не используем чужие коммерческие PDF. Ниже — четыре вымышленных инвойса разной вёрстки: Gulf IT-трейдер, немецкая Handelsrechnung, голландская ERP-фактура и авиа-MRO с прекурсорами. Система должна узнать таблицу, а не «шаблон».
        </p>
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin: 20px 0;" class="case-kpi-grid">
          <img src="/screens/doka-pdf-helionix.jpg" alt="Инвойс Helionix" style="width:100%; height:auto; border:1px solid var(--color-doka-border); border-radius:8px;" />
          <img src="/screens/doka-pdf-aurelia.jpg" alt="Инвойс Aurelia" style="width:100%; height:auto; border:1px solid var(--color-doka-border); border-radius:8px;" />
          <img src="/screens/doka-pdf-nordvolt.jpg" alt="Инвойс Nordvolt" style="width:100%; height:auto; border:1px solid var(--color-doka-border); border-radius:8px;" />
          <img src="/screens/doka-pdf-velaero.jpg" alt="Инвойс Velaero" style="width:100%; height:auto; border:1px solid var(--color-doka-border); border-radius:8px;" />
        </div>

        <h2 style="font-size: 1.5rem; color: var(--color-doka-primary); margin: 32px 0 16px;">2. Helionix: 2 позиции ИТ, коды без микросхем 8542</h2>
        <p>
          Коммутатор NX-S48 → 8517620002, сервер RX-2208 → 8471500000. Обе позиции назначены доменным правилом, не RAG top-1 (раньше такие описания уезжали в 8542). Консилиум ставит средний риск: в извлечённом заголовке нет контракта и Incoterms, хотя они есть на PDF.
        </p>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-helionix-switch.jpg" alt="Разбор инвойса Helionix в ДОКА" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 1.</strong> Helionix Trading FZE → ООО «Полярный Контур». 2/2 кодов назначено.
          </div>
        </div>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-crop-helionix-reject.jpg" alt="Почему отброшены альтернативные коды ТН ВЭД" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 2.</strong> Фрагмент карточки: «почему не соседний код» — материал для ответа инспектору.
          </div>
        </div>

        <h2 style="font-size: 1.5rem; color: var(--color-doka-primary); margin: 32px 0 16px;">3. Aurelia: Графа 31 и консилиум, который ловит ошибку</h2>
        <p>
          Две химические позиции и два разных решения: холинхлорид 75% на растительном носителе — 2309909601 (кормовой препарат), бетаин безводный 96% — 2923900000 (четвертичный аммоний). Консилиум: риск низкий, статус «Одобрено».
        </p>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-crop-aurelia-grafa31.jpg" alt="Графа 31 холинхлорида" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 3.</strong> Карточка позиции: Графа 31, код, пошлины, нетарифные меры (кормовая категория).
          </div>
        </div>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-crop-aurelia-council.jpg" alt="Консилиум: риск низкий по Aurelia" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 4.</strong> Консилиум подтверждает 2309 и 2923, несовпадений главы нет.
          </div>
        </div>

        <h2 style="font-size: 1.5rem; color: var(--color-doka-primary); margin: 32px 0 16px;">4. Nordvolt: 4 электропозиции из ERP-фактуры</h2>
        <p>
          Голландский складской бланк, 4 строки: сервопривод 8504409009, DIN-БП 8504409100, автомат 8536209007, трансформатор тока 8504318009. Все четыре извлечены и классифицированы, риск низкий.
        </p>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-nordvolt-list.jpg" alt="Разбор инвойса Nordvolt, 4 позиции" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 5.</strong> Nordvolt Components B.V. → ООО «Уралщит Электро». 4/4 назначено.
          </div>
        </div>

        <h2 style="font-size: 1.5rem; color: var(--color-doka-primary); margin: 32px 0 16px;">5. Velaero: прекурсоры — отдельный <a href="/cases/precursors-avia/" style="color: inherit;">кейс ПП-681</a></h2>
        <p>
          Три чистых растворителя для MRO: МЭК (78-93-3), толуол (108-88-3), ацетон (67-64-1). Коды 2914.12 / 2902.30 / 2914.11. Это не «ещё одна химия»: табл. II ПП РФ № 681. Консилиум ставит <strong>высокий риск</strong>, требует лицензию на оборот и журнал учёта, не даёт статус «Одобрено».
        </p>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-velaero-council.jpg" alt="Консилиум по прекурсорам Velaero" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 6.</strong> Velaero Surface Chemie → ООО «Авиакон-Сервис». Прекурсоры табл. II, особый порядок.
          </div>
        </div>
        <div style="margin: 24px 0; border: 1px solid var(--color-doka-border); border-radius: var(--radius-doka-lg); overflow: hidden; background: #FFFFFF;">
          <img src="/screens/doka-crop-velaero-precursor.jpg" alt="Карточка МЭК: предупреждение о прекурсоре ПП-681" style="width: 100%; height: auto; display: block;" />
          <div style="padding: 12px; font-size: 0.8125rem; color: var(--color-doka-text-dim); background: var(--color-doka-surface-muted); border-top: 1px solid var(--color-doka-border);">
            <strong>Рис 7.</strong> Карточка позиции: предупреждение «Прекурсоры Пост. №681» и пакет документов.
          </div>
        </div>

        <h2 style="font-size: 1.5rem; color: var(--color-doka-primary); margin: 32px 0 16px;">6. Результат: XML в Альта-ГТД после сверки человеком</h2>
        <p>
          По кнопке XML система формирует проект декларации. Финальную проверку и подачу выполняет декларант. Экраны сняты с реального прогона, не из макета.
        </p>
      </div>

      <RelatedReading heading="Тот же кейс у ФОРОНЕЯ и у архитектора" items={RELATED_BY_PAGE.cases} />

      <!-- Lead form block -->
      <div style="margin-top: 40px;">
        <LeadForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:raw>
  @media (max-width: 600px) {
    .case-kpi-grid { grid-template-columns: 1fr 1fr !important; }
  }
</style>
