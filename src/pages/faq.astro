---
// AEO FAQ — Расширенная база знаний системы ДОКА
import BaseLayout from "../layouts/BaseLayout.astro";
import SecurityNoDemoBanner from "../components/SecurityNoDemoBanner.astro";
import { FAQ, SITE_CANONICAL_BASE, buildFaqJsonLd } from "../consts";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    buildFaqJsonLd(),
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Главная", item: `${SITE_CANONICAL_BASE}/` },
        { "@type": "ListItem", position: 2, name: "FAQ", item: `${SITE_CANONICAL_BASE}/faq/` },
      ],
    },
  ],
};
---

<BaseLayout
  title="FAQ: ТН ВЭД, Альта-ГТД, on-prem, КТС — Система ДОКА"
  description="Ответы: как подобрать код ТН ВЭД по инвойсу, XML в Альта-ГТД, on-prem 152-ФЗ, стоимость внедрения, бесплатный разбор 5 файлов, риски КТС."
  canonical={`${SITE_CANONICAL_BASE}/faq/`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="section" style="padding-top: 48px;">
    <div class="container" style="max-width: 860px;">
      <div class="section-header">
        <h1 class="section-title">Часто задаваемые вопросы о системе ДОКА</h1>
        <p class="section-subtitle">
          Код ТН ВЭД по инвойсу, XML в Альта-ГТД, on-prem и 152-ФЗ, цены, КТС, старт с 5 файлов.
        </p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px;">
        {FAQ.map((f, i) => (
          <div class="doka-card" style="padding: 24px;">
            <h3 style="font-size: 1.15rem; color: var(--color-doka-primary); margin-bottom: 10px; display: flex; align-items: flex-start; gap: 10px;">
              <span style="color: var(--color-doka-accent); font-family: var(--font-mono); font-size: 0.875rem; flex-shrink: 0; margin-top: 2px;">Q{i+1}.</span>
              <span>{f.question}</span>
            </h3>
            <div style="font-size: 0.9375rem; color: var(--color-doka-text-muted); line-height: 1.6; padding-left: 28px;">
              {f.answer}
            </div>
          </div>
        ))}
      </div>

      <!-- Explicit Security & No Public Demo Banner -->
      <SecurityNoDemoBanner />

      <!-- CTA Box -->
      <div style="background: var(--color-doka-surface-muted); border: 1px solid var(--color-doka-border); padding: 28px; border-radius: var(--radius-doka-lg); text-align: center;">
        <h3 style="font-size: 1.25rem; margin-bottom: 8px;">Вопроса нет в списке</h3>
        <p style="font-size: 0.875rem; color: var(--color-doka-text-muted); margin-bottom: 20px;">
          Напишите в ООО «ГК Фороней» или пришлите 5 файлов на тестовый экспресс-разбор.
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
          <a href="/razbor/" class="doka-btn doka-btn-primary">Запросить разбор 5 файлов (0 ₽)</a>
          <a href="/contact/" class="doka-btn doka-btn-outline">Связаться с ГК «Фороней»</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
